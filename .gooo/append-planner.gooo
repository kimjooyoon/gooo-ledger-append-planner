package ledgerappendplanner
namespace ledgerappendplanner

entity TransactionRequest id "gooo://ledger-append-planner/transaction-request"
entity LedgerAST id "gooo://ledger-append-planner/ledger-ast"
entity PatchPlan id "gooo://ledger-append-planner/patch-plan"
entity ReplayReceipt id "gooo://ledger-append-planner/replay-receipt"
entity RollbackBundle id "gooo://ledger-append-planner/rollback-bundle"

activity VerifyImmutableBaseline(TransactionRequest) -> LedgerAST computes "ledger-append-planner:v1;kind=verify-baseline;stage=VERIFY;proof=FOUNDATION;indicator=DRIVER"
activity ValidateTransaction(TransactionRequest) -> LedgerAST computes "ledger-append-planner:v1;kind=validate-transaction;stage=VERIFY;proof=FOUNDATION;indicator=GUARDRAIL"
activity ParseLedgerAST(LedgerAST) -> LedgerAST computes "ledger-append-planner:v1;kind=parse-ledger-ast;stage=PARSE;proof=FOUNDATION;indicator=DRIVER"
activity ValidateAppend(LedgerAST) -> PatchPlan computes "ledger-append-planner:v1;kind=validate-append;stage=PLAN;proof=COHERENCE;indicator=GUARDRAIL"
activity BuildASTPatch(PatchPlan) -> PatchPlan computes "ledger-append-planner:v1;kind=build-ast-patch;stage=PLAN;proof=COHERENCE;indicator=OUTCOME"
activity ApplyTemporaryCopy(PatchPlan) -> ReplayReceipt computes "ledger-append-planner:v1;kind=apply-temporary-copy;stage=APPLY;proof=COHERENCE;indicator=OUTCOME"
activity RenderProjections(ReplayReceipt) -> ReplayReceipt computes "ledger-append-planner:v1;kind=render-projections;stage=APPLY;proof=COHERENCE;indicator=OUTCOME"
activity VerifyReplay(ReplayReceipt) -> RollbackBundle computes "ledger-append-planner:v1;kind=verify-replay;stage=VERIFY;proof=REGRESSION;indicator=GUARDRAIL"
activity EmitDossier(RollbackBundle) -> RollbackBundle computes "ledger-append-planner:v1;kind=emit-dossier;stage=REPORT;proof=REGRESSION;indicator=OUTCOME"

edge VerifyImmutableBaseline -> ValidateTransaction : TransactionRequest
edge ValidateTransaction -> ParseLedgerAST : LedgerAST
edge ParseLedgerAST -> ValidateAppend : LedgerAST
edge ValidateAppend -> BuildASTPatch : PatchPlan
edge BuildASTPatch -> ApplyTemporaryCopy : PatchPlan
edge ApplyTemporaryCopy -> RenderProjections : ReplayReceipt
edge RenderProjections -> VerifyReplay : ReplayReceipt
edge VerifyReplay -> EmitDossier : RollbackBundle

gooo ledger_append_transaction v1
operation append_exactly_one_adoption_transaction
path activity_file "examples/self-improvement-portfolio/main.gooo"
path profile "contracts/self-improvement-portfolio-v1.json"
path release_locks "contracts/release-locks-v1.json"
path assessment "evidence/assessment-v1.json"
path registry "evidence/non-completeness-capability-evidence-registry-v1.json"
path report "evidence/report-v1.json"
path history "evidence/history-v1.json"
template report "templates/report-v1.json.tmpl"
template history "templates/history-v1.json.tmpl"

required transaction_id
required baseline.repository
required baseline.tag
required baseline.release_id
required baseline.tag_object_sha
required baseline.target_commit_sha
required baseline.immutable
required baseline.source_archive_sha256
required baseline.source_tree_sha256
required cell.id
required cell.axis
required cell.proof
required cell.indicator
required cell.activity
required cell.release_key
required activity.name
required activity.input_type
required activity.output_type
required release_lock
required outcome.state
required outcome.evidence
required registry_entry
required migration
required expected.proof_totals
required expected.indicator_totals
required expected.status_counts
required expected.portfolio_decision

unknown-field stage
unknown-field step
unknown-field reason
unknown-field unknown_class
unknown-field next_operation
unknown-field blocked_by
precedence REFUTED>UNKNOWN>CLOSED
states CLOSED UNKNOWN REFUTED
terminal-state CLOSED
proof-class FOUNDATION
proof-class COHERENCE
proof-class REGRESSION
indicator-class DRIVER
indicator-class OUTCOME
indicator-class GUARDRAIL
release-lock-field repository
release-lock-field tag
release-lock-field release_id
release-lock-field tag_object_sha
release-lock-field target_commit_sha
release-lock-field immutable
migration operation=ADD1 add=1 retire=0 split=0
transaction-state PREPARE
transaction-state PLAN
transaction-state APPLY
transaction-state VERIFY
transaction-state ROLLBACK
invariant append-only
invariant ast-addressed-json
invariant preserve-existing-canonical-objects
invariant no-input-repository-writes
invariant no-commit-push-merge
invariant one-cell-one-activity-one-lock
invariant no-overwrite
authority repository_writes=0 upstream_writes=0 local_test_executions=0 commit=0 push=0 merge=0
process bootstrap_commit=1 post_bootstrap_direct_main=0 implementation=one-open-pr-at-a-time verification=github-actions-only development_process=REFUTED product_conformance_authority=GITHUB_ACTIONS local_validation_executions=3 local_go_test_executions=9 local_go_build_executions=0 local_go_run_compile_executions=3 local_go_vet_executions=1 local_conformance_executions=2
claim whole_language_improvement=UNKNOWN
claim external_utility=UNKNOWN/NOT_MADE
metric exact_files_changed
metric exact_files_planned
metric ast_nodes_added
metric bytes_before
metric bytes_after
metric replay_mismatches
metric repository_writes
metric generated_files
metric generated_bytes
metric wall_ms
metric peak_rss_kib
metric tests_total
metric tests_executed
metric tests_reused
metric tests_failed
metric tests_unknown
metric go_files
metric go_lines
metric gooo_files
metric gooo_lines
metric regular_files
metric directories
metric root_readme_excluded

case valid-append CLOSED
case missing-immutable-lock UNKNOWN
case duplicate-or-overwrite REFUTED
case ambiguous-textual-insertion REFUTED
case rollback-replay CLOSED
